####################
# required
####################

# db
DATABASE_URL=postgres://postgres:local123@localhost:5432/postgres

# better-auth
BETTER_AUTH_SECRET=abc123
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# google o auth
GOOGLE_CLIENT_ID=abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=abc123

####################
# optional
####################

# signs everyone in as a dev user without oauth, ignored in production
# DEV_LOGIN=true
# ADMIN_EMAILS=you@example.com

# sentry error reporting, disabled without a dsn
# NEXT_PUBLIC_SENTRY_DSN=https://abc123@o123.ingest.de.sentry.io/123
# source map upload during `next build`
# SENTRY_ORG=abc123
# SENTRY_PROJECT=abc123
# SENTRY_AUTH_TOKEN=abc123
