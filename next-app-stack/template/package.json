{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "setup": "scripts/setup-worktree.sh",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "spell": "cspell --no-progress \"**/*.ts\" \"**/*.tsx\" \"**/*.json\" \"**/*.md\"",
    "test": "bun test --isolate",
    "typecheck": "next typegen && bun check",
    "verify": "bun run format && bun run --parallel --no-exit-on-error lint typecheck spell test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "auth:generate": "bun x auth@latest generate --output ./db/schemas/auth-schema.ts"
  }
}
